# back-end/.env.example
# 실제 값은 back-end/.env 에 넣는다 (.gitignore 대상).
# 이 파일을 복사해서 사용:  cp back-end/.env.example back-end/.env

# --- DB config ---
DB_USER=fastteamjpsm
DB_PASSWORD=         # ⚠️ 각자 생성해서 채울 것
DB_HOST=127.0.0.1
DB_PORT=13306
DB_NAME=fast_db

# --- JWT & security ---
SECRET_KEY=         # ⚠️ 각자 생성해서 채울 것
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

MODEL_DIR_BASE="app/assets/models"

# 버전/임계치(모달리티별)
FACE_MODEL_VERSION="v1"
ARM_MODEL_VERSION="v1"
SPEECH_MODEL_VERSION="v2"

FACE_THRESHOLD="0.2278"
ARM_THRESHOLD="0.718"
SPEECH_THRESHOLD="0.15"

# speech 모델 경로
SPEECH_MODEL_DIR="back-end/app/assets/models/speech"
ARM_MODEL_DIR="back-end/app/assets/models/arm/v1/xgb_model.pkl"

# ===== Speech serving alignment & tuning =====
# VAD (match training)
# pyin이 일반적으로 유성 구간을 더 안정적으로 잡아 유사 발화 간 변동을 줄일 수 있음
# SPEECH_VAD_MODE=pyin   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_VAD_FRAME=512   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_VAD_HOP=160   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨

# RMS normalization (shrink-only: do not amplify low-RMS recordings)
# SPEECH_RMS_NORM=true   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_RMS_SHRINK_ONLY=true   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_RMS_TARGET=0.073   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨

# DTW scaling
# SPEECH_DTW_SCALE_MODE=auto   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨

# Conservative guard: attenuate risk if DTW ~ normal and RMS not high
# SPEECH_GUARD_ENABLE=true   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_GUARD_DTW_REF=4.5   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_GUARD_MARGIN=0.6   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_GUARD_RMS_MAX=0.095   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_GUARD_FACTOR=0.5   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨

# Hard guard: 정상 지표일 때 위험도 상한 캡 적용(선택)
# SPEECH_HARD_GUARD=true   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_HARD_GUARD_MARGIN=0.7   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_MAX_RISK_WHEN_NORMAL=0.45   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨

# Restore model-like threshold
# SPEECH_THRESHOLD_OVERRIDE=0.538   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨

# Low-DTW veto: DTW가 기준보다 과도하게 낮으면 위험도 하한을 강제
# SPEECH_LOW_DTW_VETO=true   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_LOW_DTW_MARGIN=0.2   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_MIN_RISK_WHEN_LOW_DTW=0.60   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_VETO_RMS_MIN=0.0   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_VETO_FLATNESS_MAX=0.20   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨

# Silence/no-speech veto: 발화가 거의 없으면 정상으로 떨어지지 않도록 최소 리스크 부여
# SPEECH_SILENCE_VETO=true   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_MIN_VOICED_SEC=2.0   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_SILENCE_RMS_MAX=0.020   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_MIN_RISK_WHEN_SILENCE=0.65   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_MIN_NON_SILENT_SEC=3.0   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_NON_SILENT_TOP_DB=28   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨

# Abnormal lock-in: 명확한 이상(높은 DTW/RMS)에서는 위험도 최소 보장
# SPEECH_ABN_LOCK_ENABLE=true   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_ABN_DTW_MARGIN=1.0   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_ABN_RMS_MIN=0.11   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_ABN_MIN_RISK=0.70   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨

# Hard low-DTW abnormal (사용자 요청): dtw_avg가 매우 낮으면 최소 위험도 보장
# SPEECH_LOW_DTW_HARD=true   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_LOW_DTW_HARD_TH=4.0   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_LOW_DTW_HARD_MIN_RISK=0.80   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
# SPEECH_LOW_DTW_HARD_MIN_NON_SILENT=0.0   # (사용 안 함) 옛 DTW 레시피 전용 — 9단계에서 코드 삭제됨
