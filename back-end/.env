# --- DB config ---
DB_USER=fastteamjpsm
DB_PASSWORD=fast!jpsm
DB_HOST=127.0.0.1
DB_PORT=13306
DB_NAME=fast_db

# --- JWT & security ---
SECRET_KEY=여기에_아직_안바뀐_시크릿
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

MODEL_DIR_BASE="app/assets/models"

# 버전/임계치(모달리티별)
FACE_MODEL_VERSION="v1"
ARM_MODEL_VERSION="v1"
SPEECH_MODEL_VERSION="v1"

FACE_THRESHOLD="0.2278"
ARM_THRESHOLD="0.718"
SPEECH_THRESHOLD="0.5"

# speech 모델 경로
SPEECH_MODEL_DIR="back-end/app/assets/models/speech"
ARM_MODEL_DIR="back-end/app/assets/models/arm/v1/xgb_model.pkl"

# ===== Speech serving alignment & tuning =====
# VAD (match training)
# pyin이 일반적으로 유성 구간을 더 안정적으로 잡아 유사 발화 간 변동을 줄일 수 있음
SPEECH_VAD_MODE=pyin
SPEECH_VAD_FRAME=512
SPEECH_VAD_HOP=160

# RMS normalization (shrink-only: do not amplify low-RMS recordings)
SPEECH_RMS_NORM=true
SPEECH_RMS_SHRINK_ONLY=true
SPEECH_RMS_TARGET=0.073

# DTW scaling
SPEECH_DTW_SCALE_MODE=auto

# Conservative guard: attenuate risk if DTW ~ normal and RMS not high
SPEECH_GUARD_ENABLE=true
SPEECH_GUARD_DTW_REF=4.5
SPEECH_GUARD_MARGIN=0.6
SPEECH_GUARD_RMS_MAX=0.095
SPEECH_GUARD_FACTOR=0.5

# Hard guard: 정상 지표일 때 위험도 상한 캡 적용(선택)
SPEECH_HARD_GUARD=true
SPEECH_HARD_GUARD_MARGIN=0.7
SPEECH_MAX_RISK_WHEN_NORMAL=0.45

# Restore model-like threshold
SPEECH_THRESHOLD_OVERRIDE=0.538

# Low-DTW veto: DTW가 기준보다 과도하게 낮으면 위험도 하한을 강제
SPEECH_LOW_DTW_VETO=true
SPEECH_LOW_DTW_MARGIN=0.2
SPEECH_MIN_RISK_WHEN_LOW_DTW=0.60
SPEECH_VETO_RMS_MIN=0.0
SPEECH_VETO_FLATNESS_MAX=0.20

# Silence/no-speech veto: 발화가 거의 없으면 정상으로 떨어지지 않도록 최소 리스크 부여
SPEECH_SILENCE_VETO=true
SPEECH_MIN_VOICED_SEC=2.0
SPEECH_SILENCE_RMS_MAX=0.020
SPEECH_MIN_RISK_WHEN_SILENCE=0.65
SPEECH_MIN_NON_SILENT_SEC=3.0
SPEECH_NON_SILENT_TOP_DB=28

# Abnormal lock-in: 명확한 이상(높은 DTW/RMS)에서는 위험도 최소 보장
SPEECH_ABN_LOCK_ENABLE=true
SPEECH_ABN_DTW_MARGIN=1.0
SPEECH_ABN_RMS_MIN=0.11
SPEECH_ABN_MIN_RISK=0.70

# Hard low-DTW abnormal (사용자 요청): dtw_avg가 매우 낮으면 최소 위험도 보장
SPEECH_LOW_DTW_HARD=true
SPEECH_LOW_DTW_HARD_TH=4.0
SPEECH_LOW_DTW_HARD_MIN_RISK=0.80
SPEECH_LOW_DTW_HARD_MIN_NON_SILENT=0.0