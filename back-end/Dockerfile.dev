# back-end/Dockerfile.dev
FROM python:3.12-slim

# 시스템 패키지
#   ffmpeg          : webm/mp3 디코딩 (load_audio_16k 가 subprocess 로 호출)
#   libgomp1        : OpenMP 런타임. xgboost/sklearn 이 요구 (macOS 의 libomp 에 해당)
#   libglib2.0-0    : opencv-python / mediapipe 의존
#   libgl1          : opencv 의 GUI 백엔드 의존
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        libgomp1 \
        libglib2.0-0 \
        libgl1 \
    && rm -rf /var/lib/apt/lists/*

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# 의존성을 먼저 — 소스가 바뀌어도 이 레이어는 캐시된다
COPY requirements.txt /tmp/requirements.txt

# torch 를 CPU 전용 인덱스에서 먼저 설치한다.
# PyPI 기본 torch 는 CUDA 빌드라 nvidia-*/triton 으로 4.3GB 가 따라온다.
# 이 서비스는 CPU 추론(측정: CPU 0.267s vs MPS 1.271s)이므로 전부 사용되지 않는다.
RUN pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        torch==2.2.2

# torch 가 이미 충족돼 pip 이 재설치하지 않는다
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# 소스는 compose 에서 볼륨 마운트하지만, 이미지 단독 실행도 되게 복사해둔다
COPY back-end/ /app/

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
